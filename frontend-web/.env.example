# Frontend Environment Variables

# API Configuration
VITE_API_URL=http://localhost:5001/api
# Do NOT set VITE_SOCKET_URL to a /api URL. Use backend origin only, or omit to auto-derive.
# VITE_SOCKET_URL=http://localhost:5001

# Optional but recommended for deployed WebRTC behind stricter NATs/firewalls
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Stripe Configuration
VITE_STRIPE_KEY=pk_test_your_stripe_publishable_key

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# reCAPTCHA Configuration
# Get your keys from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=6LfeNa8sAAAAALrhZIQvVLh6p4Xcv4sagnaHOu-F
