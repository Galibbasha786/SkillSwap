{
  "name": "skillswap",
  "private": true,
  "description": "SkillSwap monorepo scripts",
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend-web",
    "install:all": "npm install --prefix backend && npm install --prefix frontend-web",
    "start:backend": "npm start --prefix backend",
    "build:frontend": "npm run build --prefix frontend-web"
  }
}
