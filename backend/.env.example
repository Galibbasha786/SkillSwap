# Backend Environment Variables

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/skillswap

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# Server Port
PORT=5000
CLIENT_URL=http://localhost:5173
# Optional: comma-separated extra frontend origins for previews/custom domains
CLIENT_URLS=
# Optional alias for multiple deployed frontends (comma-separated full origins)
ALLOWED_ORIGINS=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration
EMAIL_HOST=your_email_host
EMAIL_PORT=587
EMAIL_USER=your_email
EMAIL_PASS=your_email_password

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# reCAPTCHA Configuration
# Get your keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=6LfeNa8sAAAAADzBHITxZKEzqqEvVWZaS5RV_hlY

# Python Shell Configuration
PYTHON_PATH=/usr/bin/python3
